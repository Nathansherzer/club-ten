{
  "version": 2,
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.topclubten.com" }],
      "destination": "https://topclubten.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.topclubten.com" }],
      "destination": "https://topclubten.com/:path*",
      "permanent": true
    },
    {
      "source": "/tpp/:club/:date",
      "destination": "/:club?partner=tpp&date=:date&utm_source=thepeoplesperson&utm_medium=social&utm_campaign=tpp-daily-post",
      "permanent": false
    }
  ],
  "functions": {
    "api/puzzle.js":      { "includeFiles": "puzzles/**" },
    "api/archive.js":     { "includeFiles": "puzzles/**" },
    "api/guess.js":       { "includeFiles": "puzzles/**" },
    "api/reveal.js":      { "includeFiles": "puzzles/**" },
    "api/puzzle-page.js": { "includeFiles": "puzzles/**" },
    "api/sitemap.js":     { "includeFiles": "puzzles/**" },
    "api/blog-post.js":   { "includeFiles": "blog-src/**" }
  },
  "crons": [
    { "path": "/api/indexnow", "schedule": "5 0 * * *" }
  ],
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/blog/:slug",  "destination": "/api/blog-post?slug=:slug" },

    { "source": "/arsenal/:date",           "destination": "/api/puzzle-page?club=arsenal&date=:date" },
    { "source": "/chelsea/:date",           "destination": "/api/puzzle-page?club=chelsea&date=:date" },
    { "source": "/liverpool/:date",         "destination": "/api/puzzle-page?club=liverpool&date=:date" },
    { "source": "/manchester-city/:date",   "destination": "/api/puzzle-page?club=manchester-city&date=:date" },
    { "source": "/manchester-united/:date", "destination": "/api/puzzle-page?club=manchester-united&date=:date" },
    { "source": "/tottenham/:date",         "destination": "/api/puzzle-page?club=tottenham&date=:date" }
  ]
}
